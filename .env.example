# ---- Database (Neon) -------------------------------------------------------
# Pooled connection — used by the app at runtime (PgBouncer mode).
# Copy this from your Neon dashboard (connection string with "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection — used ONLY by `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- API token -------------------------------------------------------------
# Single-user gate for /api/* endpoints (used by n8n, future mobile app).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATOM_API_TOKEN="change-me-to-a-long-random-string"

# ---- Discord bot -----------------------------------------------------------
# From https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=""

# Bot's API target (defaults to http://localhost:3000)
# ATOM_API_URL="http://localhost:3000"

# ---- Neon Auth (Managed Better Auth) ---------------------------------------
# NEON_AUTH_BASE_URL is pulled by the Neon CLI. Generate the cookie secret:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="change-me-generate-32-plus-chars"
